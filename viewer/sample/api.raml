#%RAML 1.0
title: Bookstore API
version: v2
baseUri: https://{tenant}.books.example.com/{version}
baseUriParameters:
  tenant:
    description: The tenant subdomain
    type: string
    pattern: ^[a-z0-9-]+$
mediaType: [application/json]
protocols: [HTTP, HTTPS]
description: |
  A worked example exercising every construct the tree carries.
documentation:
  - title: Getting started
    content: Obtain a token, then call `/books`.
annotationTypes:
  deprecated:
    type: string
    allowedTargets: [Method, TypeDeclaration]
  rateLimit:
    type: object
    properties:
      perMinute: integer
securitySchemes:
  oauth2:
    type: OAuth 2.0
    description: Standard three-legged flow.
    settings:
      authorizationUri: https://books.example.com/oauth/authorize
      accessTokenUri: https://books.example.com/oauth/token
      authorizationGrants: [authorization_code, client_credentials]
      scopes: [read:books, write:books, delete:books, read:reviews, write:reviews, admin:catalogue]
    describedBy:
      headers:
        Authorization:
          description: Bearer token
          type: string
      responses:
        401:
          description: Not authenticated
  basic:
    type: Basic Authentication
    description: Username and password, for server-to-server callers only.
    describedBy:
      headers:
        Authorization:
          description: The word Basic, a space, then base64(user:password).
          type: string
      responses:
        401:
          description: Missing or malformed credentials.
types:
  Money:
    displayName: Monetary amount
    description: An amount and the currency it is denominated in.
    type: object
    properties:
      amount:
        type: number
        minimum: 0
        multipleOf: 0.01
      currency:
        type: string
        enum: [USD, EUR, GBP]
  Entity:
    type: object
    properties:
      id: string
      createdAt: datetime
  Book:
    type: Entity
    displayName: A Book
    description: One book in the catalogue.
    (deprecated): use Publication instead
    properties:
      title:
        displayName: Title
        description: The book's title as printed on the cover.
        type: string
        minLength: 1
        maxLength: 200
        example: Dune
      isbn:
        displayName: ISBN-13
        description: The thirteen-digit ISBN, without separators.
        type: string
        pattern: ^\d{13}$
      price: Money
      tags?:
        type: array
        items: string
        uniqueItems: true
        maxItems: 10
      related?: Book[]
      reviews?:
        description: Up to twenty reviews, most recent first.
        type: Review[]
        maxItems: 20
      priceHistory?: Prices
      metadata?:
        type: object
        properties:
          /^x-/: string
    example:
      id: b-1
      createdAt: 2024-01-01T00:00:00Z
      title: Dune
      isbn: "9780441013593"
      price: { amount: 9.99, currency: USD }
  Prices:
    displayName: Price history
    description: Every price this book has been sold at, oldest first.
    type: Money[]

  Review:
    displayName: A review
    description: One reader's verdict on a book.
    type: object
    properties:
      rating:
        description: Stars, one to five.
        type: integer
        minimum: 1
        maximum: 5
      body?: string
      author:
        type: object
        properties:
          name: string
          verified:
            type: boolean
            default: false
    examples:
      terse:
        rating: 5
        author: { name: Ada, verified: true }
      full:
        rating: 3
        body: Uneven, but the middle third is superb.
        author: { name: Grace, verified: false }

  Shelf:
    displayName: A shelf
    description: An array whose items are declared inline rather than by name.
    type: array
    minItems: 1
    items:
      displayName: Shelf slot
      type: object
      properties:
        position: integer
        book: Book
        note?: string

  Payload:
    displayName: Anything postable
    description: A union whose members are an array and an object, to show both.
    type: Book[] | Review
  Chain:
    type: object
    properties:
      next?: Chain
  Search:
    type: string | number
  Paged:
    type: object
    properties:
      total: integer
      items: array

  Publication:
    displayName: A publication
    description: Everything the store sells. The `kind` property says which.
    type: object
    discriminator: kind
    properties:
      kind: string
      title: string
  Magazine:
    description: 'A periodical, told apart by `kind: monthly`.'
    type: Publication
    discriminatorValue: monthly
    properties:
      issue: integer
  Pamphlet:
    description: No `discriminatorValue`, so the value is the type's own name.
    type: Publication
    properties:
      pages: integer
traits:
  paged:
    queryParameters:
      offset?:
        type: integer
        default: 0
      limit?:
        type: integer
        default: 20
        maximum: 100
resourceTypes:
  collection:
    get:
      displayName: List <<item>>s
      description: Returns a page of <<item>> records.
      is: [paged]
      responses:
        200:
          body:
            application/json:
              type: <<item>>[]
securedBy: [oauth2]
/books:
  displayName: Books
  description: The catalogue of every book the store carries.
  type: { collection: { item: Book } }
  post:
    securedBy: [oauth2: { scopes: [write:books, read:reviews, write:reviews, admin:catalogue] }, basic]
    displayName: Add a book
    description: Adds one book to the catalogue and returns it with its identifier.
    (deprecated): use PUT
    body:
      application/json:
        type: Book
    responses:
      201:
        description: Created
        headers:
          Location: string
        body:
          application/json:
            type: Book
      400:
        description: Bad request
  /{isbn}:
    uriParameters:
      isbn:
        type: string
        pattern: ^\d{13}$
    get:
      displayName: Retrieve a book
      description: Returns one book by its ISBN-13.
      securedBy: [oauth2: { scopes: [read:books] }, null]
      responses:
        200:
          body:
            application/json:
              type: Book
    delete:
      displayName: Delete a book
      description: Removes a book from the catalogue. Idempotent.
      securedBy: [oauth2: { scopes: [write:books] }]
      responses:
        204:
/shelves:
  displayName: Shelves
  description: Physical arrangement of the catalogue.
  post:
    displayName: Create a shelf
    description: Accepts either a list of books or a single review.
    body:
      application/json:
        type: Payload
    responses:
      201:
        description: Created
        body:
          application/json:
            type: Shelf
      422:
        description: The payload matched neither member of the union.
      500:
        description: Something went wrong on our side.

/publications:
  displayName: Publications
  description: Books, magazines and pamphlets, discriminated by `kind`.
  get:
    displayName: List publications
    description: Every publication, of whatever kind.
    # Narrower than the API's own `[HTTP, HTTPS]`, which changes the scheme of
    # the URL a caller builds for this method alone.
    protocols: [HTTPS]
    responses:
      200:
        body:
          application/json:
            type: Publication[]

/search:
  displayName: Search
  get:
    displayName: Search the catalogue
    description: Full-text search across titles and authors.
    queryParameters:
      q:
        type: Search
        required: true
    responses:
      200:
        body:
          application/json:
            type: Book[]
