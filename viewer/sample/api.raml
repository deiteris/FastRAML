#%RAML 1.0
title: Bookstore API
version: v2
baseUri: https://{tenant}.books.example.com/{version}
baseUriParameters:
  tenant:
    description: The tenant subdomain
    type: string
    pattern: ^[a-z0-9-]+$
mediaType: [application/json]
protocols: [HTTP, HTTPS]
description: |
  A worked example exercising every construct the tree carries — including
  **Markdown** in a description, which is what the RAML spec says every
  `description:` is.

  See [Getting started](#) for the `{tenant}` you will need.
documentation:
  - title: Getting started
    content: |
      Every request goes to your own tenant, so the first thing to settle is
      the `{tenant}` in the base URI: it is the subdomain you were given at
      sign-up, and it is not optional.

          curl https://acme.books.example.com/v2/books

      Reads of the catalogue are open. Anything that writes needs a token —
      see **Authentication** below.
  - title: Authentication
    content: |
      The API speaks OAuth 2.0. Send the caller to `/oauth/authorize`, exchange
      the code at `/oauth/token`, and put the result in an `Authorization`
      header:

          Authorization: Bearer <token>

      Ask for the narrowest scopes that will do. `read:books` is enough to
      list and retrieve; `write:books` is needed to add one; `admin:catalogue`
      is for tools, not for applications.

      `GET /books/{isbn}` may also be called with no token at all, which is
      what the open padlock on that method means.
  - title: Pagination
    content: |
      Collections are paged with `offset` and `limit`. `limit` defaults to 20
      and is capped at 100; asking for more is not an error, it is quietly
      reduced.

      There is no cursor. Adding a book while you page can shift the window,
      so a client walking the whole catalogue should sort and de-duplicate on
      `isbn` rather than trusting the offsets.
  - title: Errors
    content: |
      Failures use the status code and nothing else — there is no error
      envelope to parse.

      * `400` — the body did not match the schema on this page.
      * `401` — no token, or one that has expired.
      * `422` — the body was well-formed but matched no member of a union.
      * `500` — ours. Retry with backoff; it is safe for every method here
        except `POST /books`, which is not idempotent.
uses:
  common: !include common.raml
  # Outside this document's directory, so the path to it ascends.
  measures: !include ../shared/measures.raml
annotationTypes:
  deprecated:
    type: string
    allowedTargets: [Method, TypeDeclaration]
  rateLimit:
    type: object
    properties:
      perMinute: integer
securitySchemes:
  oauth2:
    type: OAuth 2.0
    description: Standard three-legged flow.
    settings:
      authorizationUri: https://books.example.com/oauth/authorize
      accessTokenUri: https://books.example.com/oauth/token
      authorizationGrants: [authorization_code, client_credentials]
      scopes: [read:books, write:books, delete:books, read:reviews, write:reviews, admin:catalogue]
    describedBy:
      headers:
        Authorization:
          description: Bearer token
          type: string
      responses:
        401:
          description: Not authenticated
  # Declared in a file of its own, and outside the API's directory, so the
  # scheme a view shows has to come through the link rather than off the
  # declaration that holds it.
  machineToken: !include ../shared/machine.raml
  basic:
    type: Basic Authentication
    description: Username and password, for server-to-server callers only.
    describedBy:
      headers:
        Authorization:
          description: The word Basic, a space, then base64(user:password).
          type: string
      responses:
        401:
          description: Missing or malformed credentials.
types:
  Money:
    displayName: Monetary amount
    description: An amount and the currency it is denominated in.
    type: object
    properties:
      amount:
        type: number
        minimum: 0
        multipleOf: 0.01
      currency:
        type: string
        enum: [USD, EUR, GBP]
  Entity:
    type: object
    # What a *subtype* must supply, which is not what this type carries:
    # `Entity` neither has to satisfy `stewardedBy` nor may supply a value for
    # it (docs/10 section 4). One required and one optional, because a view
    # that shows only the names says neither.
    facets:
      stewardedBy: string
      retiredAfter?: date-only
    properties:
      id: string
      createdAt: datetime

  # A named type that is not an object. Referred to by name, it has no
  # properties to list and everything it does say is a facet -- which is the
  # case a view that only opens objects shows as a link and nothing else.
  Isbn:
    displayName: ISBN-13
    description: The thirteen-digit ISBN, without separators.
    type: string
    pattern: ^\d{13}$
    minLength: 13
    maxLength: 13
    example: "9780441013593"
  Book:
    type: Entity
    displayName: A Book
    description: |
      One book in the catalogue.

      A book is identified by its `isbn`, which is the *thirteen*-digit form
      with no separators. Two fields are worth knowing about:

      * `price` is the current price; `priceHistory` is every price it has
        had, oldest first.
      * `related` is a list of other books, and may point back at this one.
    (deprecated): use Publication instead
    # The other half of `Entity`'s `facets:` -- the value this subtype supplies.
    stewardedBy: catalogue-team
    properties:
      title:
        displayName: Title
        description: The book's title as printed on the cover.
        type: string
        minLength: 1
        maxLength: 200
        example: Dune
      isbn: Isbn
      price: Money
      # Items with constraints of their own. The array's facets say how many
      # there may be; only the item's say what one may contain.
      tags?:
        type: array
        items:
          type: string
          minLength: 2
          maxLength: 24
          pattern: ^[a-z][a-z0-9-]*$
          example: science-fiction
        uniqueItems: true
        maxItems: 10
      related?: Book[]
      reviews?:
        description: Up to twenty reviews, most recent first.
        type: Review[]
        maxItems: 20
      priceHistory?: Prices
      metadata?:
        type: object
        properties:
          /^x-/: string
    example:
      id: b-1
      createdAt: 2024-01-01T00:00:00Z
      title: Dune
      isbn: "9780441013593"
      price: { amount: 9.99, currency: USD }
  Prices:
    displayName: Price history
    description: Every price this book has been sold at, oldest first.
    type: Money[]

  Review:
    displayName: A review
    description: One reader's verdict on a book.
    type: object
    properties:
      rating:
        description: Stars, one to five.
        type: integer
        minimum: 1
        maximum: 5
      body?: string
      author:
        type: object
        properties:
          name: string
          verified:
            type: boolean
            default: false
    # Form B: the value under `value:`, with what the author wrote beside it.
    # `strict: false` is the whole reason the third one is here.
    examples:
      terse:
        rating: 5
        author: { name: Ada, verified: true }
      full:
        displayName: A full review
        description: Everything a review may carry, including the optional body.
        value:
          rating: 3
          body: Uneven, but the middle third is superb.
          author: { name: Grace, verified: false }
      legacy:
        displayName: An older record
        description: Kept to show what the v1 API used to return.
        strict: false
        value:
          rating: 3
          author: Grace

  Shelf:
    displayName: A shelf
    description: An array whose items are declared inline rather than by name.
    type: array
    minItems: 1
    items:
      displayName: Shelf slot
      type: object
      properties:
        position: integer
        book: Book
        note?: string
        # A facet value longer than the column it lands in, two levels of
        # nesting down -- the narrowest container in the app -- and with no
        # space in it to break at.
        locator?:
          description: Where the physical copy sits, as one string.
          type: string
          pattern: ^(?:[A-Z]{2}-)?(?:AISLE|BAY|SHELF)-[0-9]{1,3}(?:\.[0-9]{1,2})?(?:-(?:LEFT|RIGHT|CENTRE))?(?:/[A-Za-z0-9_]{1,16})*$
          example: GB-SHELF-12.3-LEFT/reserve

  Payload:
    displayName: Anything postable
    description: A union whose members are an array and an object, to show both.
    type: Book[] | Review
  Chain:
    type: object
    properties:
      next?: Chain
  Search:
    type: string | number

  # Nine members. A union's `type_expr` is one unbreakable run of the author's
  # text, and at this length it is what a heading has to hold.
  Anything:
    displayName: Any payload
    description: Everything this API will accept in a body, as one type.
    type: Book | Review | Money | Shelf | Prices | Publication | Magazine | Pamphlet | Delivery

  Paged:
    type: object
    properties:
      total: integer
      items: Anything[]

  # A type built from a library's, reached through the `common.` prefix bound
  # in `uses:` above.
  DeliveryQuery:
    displayName: Delivery search
    description: |
      The whole query string as one type. RAML allows this instead of
      `queryParameters:`, never as well as it.
    type: object
    properties:
      since:
        description: Only deliveries promised on or after this instant.
        type: datetime
        example: 2024-06-01T00:00:00Z
      status?:
        type: string
        enum: [pending, sent, delivered]
        example: sent
      city?:
        description: Matched against the address, case-insensitively.
        type: string
        example: Bristol
      carrier?:
        description: Only deliveries handed to this carrier.
        type: string
        enum:
          - royal-mail-tracked-48-signed-for
          - dpd-next-day-before-noon
          - evri-standard

  Delivery:
    displayName: A delivery
    description: Where an order goes, and when it was promised.
    type: object
    properties:
      address: common.Address
      promisedFor: datetime
      parcel?: measures.Parcel

  # The other form: the schema written inline as a string, with no `!include`.
  # Same kind, same two representations; only where the text came from differs.
  Barcode:
    displayName: A barcode
    description: Declared by a JSON Schema written in place.
    type: |
      {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": ["symbology", "code"],
        "properties": {
          "symbology": { "type": "string", "enum": ["EAN-13", "UPC-A", "CODE-128"] },
          "code": { "type": "string", "minLength": 1 }
        }
      }
    # Not a property named `value`: an example map carrying one is RAML's
    # extended form, and every sibling key is then a field of the wrapper.
    example:
      symbology: EAN-13
      code: "9780441013593"

  Publication:
    displayName: A publication
    description: Everything the store sells. The `kind` property says which.
    type: object
    discriminator: kind
    properties:
      kind: string
      title: string
  Magazine:
    description: 'A periodical, told apart by `kind: monthly`.'
    type: Publication
    discriminatorValue: monthly
    properties:
      issue: integer
  Pamphlet:
    description: No `discriminatorValue`, so the value is the type's own name.
    type: Publication
    properties:
      pages: integer

  # A type declared by JSON Schema rather than by RAML. The spec allows the
  # wrapper facets only -- displayName, description, example, annotations --
  # and no RAML facet may sit beside the schema.
  Invoice:
    displayName: An invoice
    description: Declared by an external JSON Schema, not by RAML facets.
    type: !include invoice.json
    example:
      number: INV-000417
      total: 24.5
      paid: false
      lines:
        - description: One paperback
          amount: 24.5
traits:
  paged:
    queryParameters:
      offset?:
        type: integer
        default: 0
      limit?:
        type: integer
        default: 20
        maximum: 100
resourceTypes:
  collection:
    get:
      displayName: List <<item>>s
      description: Returns a page of <<item>> records.
      is: [paged]
      responses:
        200:
          body:
            application/json:
              type: <<item>>[]
securedBy: [oauth2]
/books:
  displayName: Books
  description: The catalogue of every book the store carries.
  type: { collection: { item: Book } }
  post:
    securedBy: [oauth2: { scopes: [write:books, read:reviews, write:reviews, admin:catalogue] }, basic]
    displayName: Add a book
    description: Adds one book to the catalogue and returns it with its identifier.
    (deprecated): use PUT
    # Two media types for one body: the same schema, accepted either way.
    body:
      application/json:
        type: Book
      application/xml:
        type: Book
    responses:
      201:
        description: Created
        headers:
          Location: string
        body:
          application/json:
            type: Book
      400:
        description: |
          The body did not match `Book` — see the schema above. The response
          carries no envelope; the status code is the whole of it.
  /{isbn}:
    uriParameters:
      isbn:
        type: string
        pattern: ^\d{13}$
    get:
      displayName: Retrieve a book
      description: Returns one book by its ISBN-13.
      securedBy: [oauth2: { scopes: [read:books] }, null]
      responses:
        200:
          body:
            application/json:
              type: Book
            application/xml:
              type: Book
    delete:
      displayName: Delete a book
      description: Removes a book from the catalogue. Idempotent.
      securedBy: [oauth2: { scopes: [write:books] }]
      responses:
        204:
/shelves:
  displayName: Shelves
  description: Physical arrangement of the catalogue.
  post:
    displayName: Create a shelf
    description: Accepts either a list of books or a single review.
    body:
      application/json:
        type: Payload
    responses:
      201:
        description: Created
        body:
          application/json:
            type: Shelf
      422:
        description: The payload matched neither member of the union.
      500:
        description: Something went wrong on our side.

/deliveries:
  displayName: Deliveries
  description: Where the store has sent things.
  get:
    displayName: List deliveries
    description: Every delivery, newest first.
    # A use site for the included scheme, so the page that reports it bound and
    # the page that says how to satisfy it are both exercised.
    securedBy: [machineToken: { scopes: [read:deliveries] }, oauth2: { scopes: [read:books] }]
    (common.internal):
    queryString: DeliveryQuery
    responses:
      200:
        body:
          application/json:
            type: Delivery[]

/publications:
  displayName: Publications
  description: Books, magazines and pamphlets, discriminated by `kind`.
  get:
    displayName: List publications
    description: Every publication, of whatever kind.
    # Narrower than the API's own `[HTTP, HTTPS]`, which changes the scheme of
    # the URL a caller builds for this method alone.
    protocols: [HTTPS]
    responses:
      200:
        body:
          application/json:
            type: Publication[]

/search:
  displayName: Search
  get:
    displayName: Search the catalogue
    description: Full-text search across titles and authors.
    queryParameters:
      q:
        displayName: Query
        description: The words to search for. Quoted phrases are matched whole.
        type: Search
        required: true
        example: "\"the dispossessed\" le guin"
      sort?:
        description: A field name, optionally prefixed with `-` to reverse it.
        type: string
        pattern: ^-?(title|isbn|price)$
        default: title
        example: -price
    responses:
      200:
        body:
          application/json:
            type: Book[]
