[project]
name = {{ package.distribution | repr }}
version = {{ (package.version | replace('v', '')) | repr if package.version else "'0.1.0'" }}
description = {{ (package.title + ' — a client generated from its RAML 1.0 definition') | repr }}
readme = "README.md"
requires-python = ">=3.12"
dependencies = ["httpx>=0.27"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = [{{ package.module | repr }}]
artifacts = [{{ (package.module + '/py.typed') | repr }}]

[tool.ruff]
target-version = "py312"
line-length = 120

[tool.ruff.format]
quote-style = "single"

[tool.mypy]
python_version = "3.12"
strict = true
