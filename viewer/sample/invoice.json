{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Invoice",
  "description": "A type declared by JSON Schema rather than by RAML.",
  "type": "object",
  "required": ["number", "total"],
  "properties": {
    "number": {
      "type": "string",
      "description": "The invoice number, as printed.",
      "pattern": "^INV-[0-9]{6}$"
    },
    "total": {
      "type": "number",
      "description": "The amount due, in the currency of the account.",
      "minimum": 0,
      "multipleOf": 0.01
    },
    "paid": {
      "type": "boolean",
      "default": false
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/line" }
    }
  },
  "definitions": {
    "line": {
      "type": "object",
      "required": ["description", "amount"],
      "properties": {
        "description": { "type": "string" },
        "amount": { "type": "number" }
      }
    }
  }
}
